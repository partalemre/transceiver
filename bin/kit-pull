#!/usr/bin/env bash
# Copies the MODZ drawing kit into hooks/kit so the mod ships self-contained: only the kit files the hooks and
# tests import (MODZ bin/kit-sync follows the imports). MODZ is $MODZ, else a sibling of this repo.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MODZ_DIR="${MODZ:-$(dirname "$ROOT")/MODZ}"
[ -x "$MODZ_DIR/bin/kit-sync" ] || { echo "kit: $MODZ_DIR/bin/kit-sync not found; set MODZ=/path/to/MODZ" >&2; exit 1; }
"$MODZ_DIR/bin/kit-sync" "$ROOT"
